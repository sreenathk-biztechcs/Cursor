<?xml version="1.0" encoding="utf-8"?>
<!-- OWL template for the Server Monitoring Dashboard (Odoo 19) -->
<!-- For Odoo 14, use QWeb templates with t-name registered via core.qweb.add_template -->
<templates xml:space="preserve">
    <t t-name="server_monitoring.Dashboard">
        <div class="o_server_monitoring_dashboard">
            <!-- Loading State -->
            <div t-if="state.loading" class="sm-loading">
                <i class="fa fa-spinner fa-spin fa-3x"/> Loading dashboard...
            </div>

            <div t-else="">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2>Server Monitoring Dashboard</h2>
                    <button class="btn btn-outline-secondary" t-on-click="onRefresh">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                </div>

                <!-- KPI Cards -->
                <div class="sm-kpi-row">
                    <div class="sm-kpi-card">
                        <div class="sm-kpi-value" t-esc="state.summary.total_servers"/>
                        <div class="sm-kpi-label">Total Servers</div>
                    </div>
                    <div class="sm-kpi-card sm-kpi-healthy">
                        <div class="sm-kpi-value" t-esc="state.summary.healthy"/>
                        <div class="sm-kpi-label">Healthy</div>
                    </div>
                    <div class="sm-kpi-card sm-kpi-warning">
                        <div class="sm-kpi-value" t-esc="state.summary.warning"/>
                        <div class="sm-kpi-label">Warning</div>
                    </div>
                    <div class="sm-kpi-card sm-kpi-critical">
                        <div class="sm-kpi-value" t-esc="state.summary.critical"/>
                        <div class="sm-kpi-label">Critical</div>
                    </div>
                    <div class="sm-kpi-card sm-kpi-idle">
                        <div class="sm-kpi-value" t-esc="state.summary.idle"/>
                        <div class="sm-kpi-label">Idle Servers</div>
                    </div>
                    <div class="sm-kpi-card">
                        <div class="sm-kpi-value" t-esc="state.summary.active_alerts"/>
                        <div class="sm-kpi-label">Active Alerts</div>
                    </div>
                </div>

                <!-- AI Summary -->
                <div class="sm-ai-summary" t-if="state.summary.ai_summary">
                    <div class="sm-ai-summary-title">
                        <i class="fa fa-robot"/> AI Fleet Summary
                    </div>
                    <t t-esc="state.summary.ai_summary"/>
                </div>

                <!-- Charts -->
                <div class="sm-charts-row">
                    <div class="sm-chart-card">
                        <div t-ref="cpuChart" class="sm-chart-container"/>
                    </div>
                    <div class="sm-chart-card">
                        <div t-ref="topCpuChart" class="sm-chart-container"/>
                    </div>
                </div>

                <!-- Server Cards -->
                <h4 class="mb-3">Server Overview</h4>
                <div class="sm-server-cards">
                    <t t-foreach="state.servers" t-as="server" t-key="server.id">
                        <div t-attf-class="sm-server-card health-{{ server.health }}"
                             t-on-click="() => this.onServerClick(server.id)">
                            <div class="sm-server-name" t-esc="server.name"/>
                            <div class="sm-server-ip" t-esc="server.ip"/>
                            <div class="sm-metric-bar">
                                <span class="sm-metric-label">CPU</span>
                                <div class="sm-metric-track">
                                    <div t-attf-class="sm-metric-fill {{ server.cpu > 90 ? 'high' : server.cpu > 70 ? 'mid' : 'low' }}"
                                         t-attf-style="width: {{ server.cpu }}%"/>
                                </div>
                                <span class="sm-metric-value"><t t-esc="server.cpu"/>%</span>
                            </div>
                            <div class="sm-metric-bar">
                                <span class="sm-metric-label">RAM</span>
                                <div class="sm-metric-track">
                                    <div t-attf-class="sm-metric-fill {{ server.ram > 90 ? 'high' : server.ram > 70 ? 'mid' : 'low' }}"
                                         t-attf-style="width: {{ server.ram }}%"/>
                                </div>
                                <span class="sm-metric-value"><t t-esc="server.ram"/>%</span>
                            </div>
                            <div class="sm-metric-bar">
                                <span class="sm-metric-label">Disk</span>
                                <div class="sm-metric-track">
                                    <div t-attf-class="sm-metric-fill {{ server.disk > 90 ? 'high' : server.disk > 70 ? 'mid' : 'low' }}"
                                         t-attf-style="width: {{ server.disk }}%"/>
                                </div>
                                <span class="sm-metric-value"><t t-esc="server.disk"/>%</span>
                            </div>
                            <div class="mt-2 text-muted" style="font-size: 0.8em;"
                                 t-if="server.ai_summary" t-esc="server.ai_summary"/>
                        </div>
                    </t>
                </div>

                <!-- Active Alerts -->
                <div class="sm-alerts-section" t-if="state.alerts.length">
                    <h4 class="mb-3">Active Alerts</h4>
                    <t t-foreach="state.alerts" t-as="alert" t-key="alert.id">
                        <div class="sm-alert-item">
                            <div t-attf-class="sm-alert-dot {{ alert.severity }}"/>
                            <strong t-esc="alert.server_name"/>
                            <span t-esc="alert.alert_name"/>
                            <span class="text-muted" t-esc="alert.description"/>
                        </div>
                    </t>
                </div>

                <!-- AI Chat (placeholder — uses AIChatWidget component) -->
                <div class="sm-ai-chat mt-4">
                    <div class="sm-chat-header">
                        <i class="fa fa-comment"/> AI Assistant
                    </div>
                    <div class="p-3 text-center text-muted">
                        AI Chat widget loads here. See ai_chat_widget.js for implementation.
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
