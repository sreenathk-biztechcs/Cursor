<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Periodic n8n healthcheck to refresh connection status -->
    <record id="ir_cron_sales_ai_n8n_healthcheck" model="ir.cron">
        <field name="name">Sales AI - n8n Healthcheck</field>
        <field name="model_id" ref="sales_ai_integration.model_sales_ai_n8n"/>
        <field name="state">code</field>
        <field name="code">model._ensure_connected()</field>
        <field name="interval_type">minutes</field>
        <field name="interval_number">15</field>
        <field name="active">False</field>
        <field name="nextcall">2026-01-01 00:00:00</field>
    </record>
</odoo>

