<?xml version="1.0" encoding="UTF-8"?>
<odoo>

<record id="view_sales_ai_res_config_settings" model="ir.ui.view">
    <field name="name">res.config.settings.sales.ai.integration</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>

    <field name="arch" type="xml">
        <xpath expr="//form" position="inside">

            <app name="sales_ai_automation" string="AI Sales Automation">

                <!-- ================================================= -->
                <!-- CLAUDE AI SECTION -->
                <!-- ================================================= -->

                <block title="Claude AI">

                    <group col="2">

                        <group>
                            <field name="claude_api_key"
                                   string="Claude API Key"
                                   password="True"/>
                        </group>

                        <group>
                            <field name="marketing_user_id"
                                   string="Marketing User for Junk / Marketing Leads"/>
                        </group>

                    </group>

                    <group>
                        <field name="claude_system_prompt"
                               string="Default Claude System Prompt"
                               widget="text"/>
                    </group>

                </block>


                <!-- ================================================= -->
                <!-- N8N INTEGRATION -->
                <!-- ================================================= -->

                <block title="n8n Integration">

                    <group col="2">

                        <group>
                            <field name="n8n_webhook_base_url"
                                   string="n8n Webhook Base URL"
                                   placeholder="https://n8n.domain/webhook"/>
                        </group>

                        <group>
                            <field name="n8n_environment"
                                   string="Environment"/>
                        </group>

                    </group>

                    <separator string="Odoo → n8n Authentication"/>

                    <group col="2">

                        <group>
                            <field name="n8n_secret_token"
                                   string="Shared Secret (Odoo ↔ n8n)"/>
                        </group>

                        <group>
                            <button name="action_generate_n8n_secret"
                                    string="Generate Secret"
                                    type="object"
                                    class="btn-secondary"/>
                        </group>

                    </group>

                    <separator string="n8n → Odoo Callback (Reverse Direction)"/>

                    <group col="2">

                        <group>
                            <field name="odoo_base_url"
                                   string="Odoo Base URL"
                                   placeholder="https://myodoo.company.com"
                                   help="Public URL of this Odoo instance. n8n will use this to call back."/>
                        </group>

                        <group>
                            <field name="odoo_api_key"
                                   string="Odoo API Key (for n8n)"

                                   help="Generate from Settings → Technical → API Keys. n8n sends this as Bearer token."/>
                        </group>

                    </group>

                    <separator string="Connection Status"/>

                    <group col="2">

                        <group>
                            <field name="n8n_status"
                                   string="Odoo → n8n"
                                   readonly="1"/>
                            <field name="n8n_last_ok"
                                   string="Last Successful Handshake"
                                   readonly="1"/>
                        </group>

                        <group>
                            <field name="n8n_reverse_status"
                                   string="n8n → Odoo"
                                   readonly="1"/>
                            <field name="n8n_last_error"
                                   string="Last Error"
                                   readonly="1"/>
                        </group>

                    </group>

                    <group>
                        <button name="action_test_n8n_connection"
                                string="Test Bidirectional Connection"
                                type="object"
                                class="btn-primary oe_highlight"/>
                    </group>

                </block>


                <!-- ================================================= -->
                <!-- APOLLO API -->
                <!-- ================================================= -->

                <block title="Apollo API">

                    <group col="2">

                        <field name="apollo_api_key"
                               string="Apollo API Key"/>

                        <field name="apollo_api_base_url"
                               string="Apollo API Base URL"
                               placeholder="https://api.apollo.io"/>

                    </group>

                </block>


                <!-- ================================================= -->
                <!-- LEAD SCORING -->
                <!-- ================================================= -->

                <block title="Lead Scoring Configuration">

                    <group>
                        <field name="icp_criteria_json"
                               string="ICP Criteria JSON"
                               widget="text"/>
                    </group>

                </block>


                <!-- ================================================= -->
                <!-- STALE DEAL CONFIG -->
                <!-- ================================================= -->

                <block title="Stale Deal Thresholds">

                    <group>
                        <field name="stale_thresholds_json"
                               string="Stale Thresholds JSON"
                               widget="text"/>
                    </group>

                </block>

            </app>

        </xpath>
    </field>

</record>

</odoo>