<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <menuitem id="menu_sales_ai_root"
              name="Sales AI"
              parent="base.menu_custom"
              sequence="50"/>

    <record id="action_sales_ai_icp_wizard" model="ir.actions.act_window">
        <field name="name">Edit ICP Criteria</field>
        <field name="res_model">sales.ai.icp.criteria.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sales_ai_icp"
              name="ICP Criteria"
              parent="menu_sales_ai_root"
              action="action_sales_ai_icp_wizard"/>

    <!-- Presale Leads — active presale filter on CRM leads -->
    <record id="action_sales_ai_presale_leads" model="ir.actions.act_window">
        <field name="name">Presale Leads</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('x_presale_status', '!=', 'none')]</field>
        <field name="context">{"search_default_active_leads": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active presale leads. Open presale from a CRM lead record.
            </p>
        </field>
    </record>

    <menuitem id="menu_sales_ai_presale_leads"
              name="Presale Leads"
              parent="menu_sales_ai_root"
              action="action_sales_ai_presale_leads"
              sequence="10"/>
</odoo>

