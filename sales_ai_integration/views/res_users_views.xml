<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_res_users_form_sales_ai" model="ir.ui.view">
        <field name="name">res.users.form.sales.ai</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h5[@name='h5_phone']" position="after">
                <h6 name="h5_calendly"
                    class="d-flex align-items-baseline mb-0">
                    <i class="fa fa-fw fa-calendar me-1 text-primary"
                       title="Phone"/>
                    <field name="x_calendar_link" placeholder="Calendly Link"
                           class="w-75"/>
                </h6>
            </xpath>
        </field>
    </record>
</odoo>

